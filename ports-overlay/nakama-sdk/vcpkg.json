{
  "name": "nakama-sdk",
  "version": "2.9.0",
  "port-version": 0,
  "description": "Nakama C/C++ client SDK (Heroic Labs) — used by intelliversex-cpp overlay",
  "homepage": "https://github.com/heroiclabs/nakama-cpp",
  "license": "Apache-2.0",
  "dependencies": [
    "protobuf",
    "rapidjson"
  ],
  "features": {
    "curl": {
      "description": "Use CURL for HTTP and websocket IO",
      "dependencies": [
        {
          "name": "curl",
          "default-features": false,
          "features": ["ssl"]
        }
      ]
    },
    "wslay": {
      "description": "Websockets via wslay",
      "dependencies": ["wslay"],
      "supports": "osx | linux | (windows & !static)"
    },
    "logs": {
      "description": "Enable log output"
    }
  },
  "default-features": ["curl", "wslay"]
}
