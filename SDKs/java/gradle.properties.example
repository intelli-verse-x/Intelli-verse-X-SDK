# Copy this file to gradle.properties (in this directory or in ~/.gradle/)
# Do NOT commit gradle.properties with real credentials.

# ─── Central Portal (OSSRH Staging API) ─────────────────────────────────────
# Generate a token at: https://central.sonatype.com → username → View User Tokens
# Use the token username and token password below (not your portal login).
ossrhStagingApiUsername=your_token_username
ossrhStagingApiPassword=your_token_password

# ─── GPG signing (choose one approach) ───────────────────────────────────────

# Option A: Use GPG command line (recommended if GPG is installed)
# Get key ID: gpg --list-keys --keyid-format short
signing.gnupg.keyName=YOUR_8_CHAR_KEY_ID
signing.gnupg.passphrase=your_gpg_passphrase

# Option B: Use key ring file (export key: gpg --export-secret-keys KEY_ID > secring.gpg)
# signing.keyId=YOUR_8_CHAR_KEY_ID
# signing.password=your_gpg_passphrase
# signing.secretKeyRingFile=/absolute/path/to/secring.gpg
