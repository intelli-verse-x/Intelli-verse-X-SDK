{
  "name": "@intelliversex/sdk",
  "version": "5.9.0",
  "description": "Intelliverse SDK for apps and games \u2014 Phygital channel adapters, quests, ads, conversations, AI, multiplayer, and live ops.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "examples"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc -p tsconfig.build.json",
    "build:prod": "tsup src/index.ts --format cjs,esm --minify && tsc -p tsconfig.build.json",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build:prod",
    "validate-publish": "npm run build:prod && npm publish --dry-run",
    "publish:public": "npm run build:prod && npm publish --access public",
    "example:phygital": "node examples/phygital-app.mjs"
  },
  "keywords": [
    "intelliversex",
    "nakama",
    "game-sdk",
    "multiplayer",
    "leaderboard",
    "authentication",
    "phygital",
    "omnichannel",
    "kiosk",
    "quests",
    "conversational-apps"
  ],
  "author": "IntelliVerse-X <support@intelli-verse-x.ai>",
  "license": "MIT",
  "homepage": "https://intelli-verse-x.github.io/Intelli-verse-X-SDK/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Intelli-verse-X/Intelli-verse-X-SDK.git",
    "directory": "SDKs/javascript"
  },
  "bugs": {
    "url": "https://github.com/Intelli-verse-X/Intelli-verse-X-SDK/issues"
  },
  "peerDependencies": {
    "@heroiclabs/nakama-js": ">=2.7.0"
  },
  "devDependencies": {
    "@heroiclabs/nakama-js": "^2.8.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@types/webxr": "^0.5.24"
  }
}
