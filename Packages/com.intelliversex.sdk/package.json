{
  "name": "com.intelliversex.sdk",
  "version": "5.10.1",
  "displayName": "IntelliVerseX SDK",
  "description": "IntelliVerseX game SDK: IVXBootstrap + Control Center (paste Game ID), Nakama backend, wallet, leaderboards, ads/IAP, social, optional Hiro/AI/Discord modules.",
  "unity": "6000.3",
  "unityRelease": "6f1",
  "documentationUrl": "https://github.com/Intelli-verse-X/Intelli-verse-X-SDK/blob/main/Packages/com.intelliversex.sdk/README.md",
  "changelogUrl": "https://github.com/Intelli-verse-X/Intelli-verse-X-SDK/blob/main/Packages/com.intelliversex.sdk/CHANGELOG.md",
  "licensesUrl": "https://github.com/Intelli-verse-X/Intelli-verse-X-SDK/blob/main/Packages/com.intelliversex.sdk/LICENSE",
  "hideInEditor": false,
  "type": "library",
  "keywords": [
    "intelliversex",
    "sdk",
    "game",
    "auth",
    "authentication",
    "localization",
    "monetization",
    "iap",
    "analytics",
    "quiz",
    "ui",
    "networking",
    "storage",
    "nakama",
    "multiplayer",
    "backend",
    "ads",
    "levelplay",
    "leaderboard",
    "social",
    "friends",
    "identity",
    "webgl",
    "mobile",
    "crossplatform",
    "ai",
    "llm",
    "nlp",
    "moderation",
    "discord",
    "persona",
    "voice",
    "multiplayer",
    "lobby",
    "matchmaking",
    "local-multiplayer",
    "pvp",
    "coop",
    "bootstrap",
    "wallet"
  ],
  "author": {
    "name": "IntelliVerse-X",
    "email": "sdk@intelliversex.com",
    "url": "https://intelliversex.com"
  },
  "dependencies": {
    "com.unity.textmeshpro": "3.0.6",
    "com.unity.nuget.newtonsoft-json": "3.2.2"
  },
  "samples": [
    {
      "displayName": "Getting Started",
      "description": "Scripts-only starter hooks. Prefer Control Center + Bootstrap; import Test Scenes for full demos.",
      "path": "Samples~/GettingStarted"
    },
    {
      "displayName": "Test Scenes",
      "description": "Pre-built test scenes for Ads, Auth, Leaderboard, Wallet (dual-wallet system: game + global), Profile, and Weekly Quiz with Nakama integration",
      "path": "Samples~/TestScenes"
    },
    {
      "displayName": "Authentication Demo",
      "description": "Complete authentication flow with login, register, OTP, and social auth",
      "path": "Samples~/Authentication"
    },
    {
      "displayName": "Quiz Game Demo",
      "description": "Complete quiz game implementation using SDK packages",
      "path": "Samples~/QuizDemo"
    },
    {
      "displayName": "Localization Example",
      "description": "Multi-language UI demo with RTL support",
      "path": "Samples~/Localization"
    },
    {
      "displayName": "IAP Integration",
      "description": "In-app purchase and subscription example",
      "path": "Samples~/IAP"
    },
    {
      "displayName": "Leaderboard Example",
      "description": "Global leaderboard with Nakama backend",
      "path": "Samples~/Leaderboard"
    },
    {
      "displayName": "Social Features",
      "description": "Friends, sharing, and referral system demo",
      "path": "Samples~/Social"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Intelli-verse-X/Intelli-verse-X-SDK.git"
  },
  "license": "MIT",
  "_ivx_externalDependencies": {
    "_comment": "Optional/required extras for the *sandbox or consumer project*, not UPM auto-deps. Package ships only TMP + Newtonsoft. Photon/Appodeal stay out of com.intelliversex.sdk. Default ads path: LevelPlay (optional). Applixir is opt-in WebGL only.",
    "external-dependency-manager": {
      "version": "1.2.186",
      "required": false,
      "installMethod": "tarball",
      "localPath": "com.google.external-dependency-manager-1.2.186.tgz",
      "description": "Needed when using Appodeal/Android native deps \u2014 not required for Bootstrap-only installs."
    },
    "appodeal": {
      "version": "3.12.0",
      "url": "https://github.com/appodeal/appodeal-unity-plugin-upm.git#v3.12.0",
      "required": false,
      "installMethod": "gitUrl",
      "packageId": "com.appodeal.mediation",
      "defineSymbol": "APPODEAL",
      "description": "Optional alternate mediation. Prefer LevelPlay for the default ads adapter."
    },
    "nakama-unity": {
      "version": "3.13.0",
      "url": "https://github.com/heroiclabs/nakama-unity/releases",
      "required": true,
      "installMethod": "unitypackage",
      "description": "Backend server connectivity for leaderboards, authentication, and storage"
    },
    "photon-pun2": {
      "version": "2.45+",
      "url": "https://assetstore.unity.com/packages/tools/network/pun-2-free-119922",
      "required": false,
      "installMethod": "assetStore",
      "description": "Optional sandbox multiplayer only. Never part of the UPM package path."
    },
    "dotween": {
      "version": "1.2.765+",
      "url": "https://assetstore.unity.com/packages/tools/animation/dotween-hotween-v2-27676",
      "required": true,
      "installMethod": "assetStore",
      "description": "Animation tweening library for UI animations"
    },
    "native-share": {
      "version": "latest",
      "url": "https://github.com/yasirkula/UnityNativeShare.git",
      "required": false,
      "installMethod": "gitUrl",
      "packageId": "com.yasirkula.nativeshare",
      "description": "Native sharing functionality for mobile platforms"
    },
    "apple-signin": {
      "version": "1.4.3+",
      "url": "https://github.com/lupidan/apple-signin-unity/releases",
      "required": false,
      "installMethod": "unitypackage",
      "description": "Sign in with Apple for iOS (required for iOS builds with Apple login)"
    },
    "levelplay": {
      "version": "9.2.0+",
      "url": "https://developers.is.com/ironsource-mobile/unity/unity-plugin/",
      "required": false,
      "installMethod": "upm",
      "packageId": "com.unity.services.levelplay",
      "defineSymbol": "IRONSOURCE",
      "description": "Preferred optional ads mediation for mobile. Not auto-installed with the package."
    },
    "_package_boundary": {
      "ships_in_upm": [
        "Packages/com.intelliversex.sdk/**"
      ],
      "sandbox_only": [
        "SDKs/unity/editor/Assets/Photon",
        "SDKs/unity/editor/Assets/AppleAuth",
        "SDKs/unity/editor/Assets/Appodeal",
        "SDKs/unity/editor/Assets/LevelPlay",
        "SDKs/unity/editor/Assets/Nakama",
        "tools/boilerplate"
      ],
      "not_in_package": [
        "TMP Examples & Extras (removed)",
        "MCP/2D/Visual Scripting (not in package deps)"
      ]
    }
  }
}
