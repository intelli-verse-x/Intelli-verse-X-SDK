{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://intelliversex.com/schemas/video-meta-v1.json",
  "title": "IntelliVerseX Video Metadata",
  "description": "Describes a streaming video asset: codec, resolution, adaptive streams, subtitles.",
  "type": "object",
  "required": ["id", "url", "format"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "title": { "type": "string" },
    "url": { "type": "string" },
    "format": { "type": "string", "enum": ["mp4", "webm"] },
    "codec": { "type": "string", "enum": ["h264", "h265", "vp9", "av1"] },
    "resolution": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "duration_sec": { "type": "number", "minimum": 0 },
    "file_size_mb": { "type": "number", "minimum": 0 },
    "bitrate_kbps": { "type": "integer", "minimum": 0 },
    "audio_codec": { "type": "string", "enum": ["aac", "opus", "vorbis", "none"] },
    "audio_channels": { "type": "integer", "minimum": 0 },
    "has_alpha": { "type": "boolean" },
    "loop": { "type": "boolean" },
    "render_texture_size": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 2,
      "maxItems": 2
    },
    "adaptive_streams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quality", "url"],
        "properties": {
          "quality": { "type": "string" },
          "url": { "type": "string" },
          "bitrate_kbps": { "type": "integer" }
        }
      }
    },
    "subtitles": {
      "type": "object",
      "patternProperties": {
        "^[a-z]{2}(-[A-Z]{2})?$": { "type": "string" }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
