{
  "version": "1.0.0",
  "lastUpdated": "2026-04-01",
  "commands": [
    {
      "id": "validate-context",
      "name": "Validate Context",
      "intent": "Run context engineering validation checks",
      "when_to_use": "Before committing changes to .cursor/ files",
      "run": "python tools/context/validate_context.py",
      "outputs": ["Validation report with findings"]
    },
    {
      "id": "validate-context-ci",
      "name": "Validate Context (CI mode)",
      "intent": "Run context validation in strict CI mode",
      "when_to_use": "In CI pipelines",
      "run": "python tools/context/validate_context.py --ci",
      "outputs": ["Pass/fail exit code", "Findings report"]
    },
    {
      "id": "build-docs",
      "name": "Build Documentation",
      "intent": "Build the MkDocs documentation site locally",
      "when_to_use": "When previewing documentation changes",
      "run": "mkdocs serve",
      "outputs": ["Local docs server at http://127.0.0.1:8000"]
    },
    {
      "id": "update-baseline",
      "name": "Update TODO/FIXME Baseline",
      "intent": "Refresh the TODO/FIXME baseline after intentional changes",
      "when_to_use": "After removing TODOs from SDK code",
      "run": "python tools/context/update_baseline.py",
      "outputs": ["Updated tools/context/baselines/todo_fixme_cs.tsv"]
    }
  ]
}
